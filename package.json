{
  "name": "multi-agent-browser-mcp",
  "version": "0.1.3",
  "mcpName": "io.github.scrollDynasty/browsermesh",
  "description": "Local isolated multi-session browser runtime for external MCP clients",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "browsermesh": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:stress": "vitest run tests/stress",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "verify:package": "npm run build && tsx scripts/verify-package.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "escape-html": "^1.0.3",
    "eslint": "^10.0.2",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scrollDynasty/multi-agent-browser-mcp.git"
  },
  "keywords": [
    "browser",
    "mcp",
    "model-context-protocol",
    "playwright",
    "automation",
    "multi-session"
  ],
  "author": "BrowserMesh contributors",
  "bugs": {
    "url": "https://github.com/scrollDynasty/multi-agent-browser-mcp/issues"
  },
  "homepage": "https://github.com/scrollDynasty/multi-agent-browser-mcp#readme"
}
